{
  "name": "jcfad-journal",
  "type": "module",
  "version": "1.0.0",
  "description": "Journal of Coastal Frontiers & Applied Development (JCFAD) - Official Independent Scholarly Journal Portal",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler pages deploy dist --project-name=jcfad-journal",
    "test:telegram": "node scripts/test-telegram.mjs",
    "article:generate": "node scripts/auto-article-groq.mjs",
    "paper:generate": "python3 scripts/generate-paper-pdf.py",
    "paper:sync-osf": "python3 scripts/sync-osf-papers.py",
    "paper:zenodo": "python3 scripts/zenodo-publisher.py"
  },
  "dependencies": {
    "astro": "^4.15.0",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "wrangler": "^4.157.0"
  }
}

