---
import Layout from '../layouts/Layout.astro';
import JournalHeader from '../components/JournalHeader.astro';
import Footer from '../components/Footer.astro';

const journalTitle = "Journal of Coastal Frontiers & Applied Development";
const journalAbbr = "JCFAD";
---

<Layout
  title={`Indexing & Repositories | ${journalTitle} (${journalAbbr})`}
  description="Academic indexing, persistent identifiers (DOI), and digital repository integrations for JCFAD."
  canonical="https://journal.chainasiaconnect.co.id/indexing"
>
  <JournalHeader />

  <main class="classic-page-container">
    <div class="container classic-page-inner">
      <div class="page-header-box">
        <div class="page-sup">JCFAD SCIENTIFIC DISSEMINATION</div>
        <h1 class="page-title">Indexing &amp; Digital Repositories</h1>
        <p class="page-desc">
          Articles published in <em>Journal of Coastal Frontiers &amp; Applied Development</em> are permanently archived, assigned digital object identifiers (DOIs), and indexed across academic search engines.
        </p>
      </div>

      <div class="index-full-list">
        <!-- 0. Scopus Elsevier -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/scopus.png" alt="Scopus" style="max-height: 42px;" />
          </div>
          <div class="index-details">
            <h3>Scopus (Elsevier) Citation Standards</h3>
            <p>
              Publication metadata, peer-review integrity protocols, and bibliographic citations are curated to conform with Scopus Elsevier indexation benchmarks, ensuring international discoverability across global scholarly databases.
            </p>
          </div>
        </div>

        <!-- 1. Google Scholar -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/google-scholar.webp" alt="Google Scholar" />
          </div>
          <div class="index-details">
            <h3>Google Scholar</h3>
            <p>
              Indexed via Highwire Press citation schema and Dublin Core standard metadata tags. Articles and citation graphs are crawlable and trackable by Google Scholar bots.
            </p>
          </div>
        </div>

        <!-- 2. Zenodo CERN -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/zenodo.png" alt="Zenodo" />
          </div>
          <div class="index-details">
            <h3>Zenodo Open Science Archive (CERN)</h3>
            <p>
              Preprints and data records are permanently preserved in CERN's high-reliability data center under the European OpenAIRE infrastructure, receiving citable DataCite DOIs.
            </p>
          </div>
        </div>

        <!-- 2b. Open Science Framework (OSF) -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/osf.png" alt="Open Science Framework" />
          </div>
          <div class="index-details">
            <h3>Open Science Framework (Center for Open Science)</h3>
            <p>
              All published journal articles, data preprints, and open science artifacts are registered on OSF Global Registry under project node <a href="https://osf.io/64xda/" target="_blank" rel="noopener noreferrer">osf.io/64xda/</a> with assigned Crossref/DataCite DOIs.
            </p>
          </div>
        </div>

        <!-- 3. ResearchGate -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/researchgate.svg" alt="ResearchGate" />
          </div>
          <div class="index-details">
            <h3>ResearchGate</h3>
            <p>
              Full-text working papers and empirical findings are linked across international researcher networks, enabling direct scientist-to-scientist correspondence and citation metrics.
            </p>
          </div>
        </div>

        <!-- 4. Crossref -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/crossref.png" alt="Crossref" />
          </div>
          <div class="index-details">
            <h3>Crossref Metadata Standards</h3>
            <p>
              Adheres to the official Crossref metadata schema and DOI syntax standards, ensuring interoperability across reference management tools (Zotero, Mendeley, EndNote).
            </p>
          </div>
        </div>

        <!-- 5. ORCID -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/orcid.png" alt="ORCID" />
          </div>
          <div class="index-details">
            <h3>ORCID Registry</h3>
            <p>
              All papers are bound to the verified Open Researcher and Contributor ID (<a href="https://orcid.org/0009-0008-1310-6169" target="_blank" rel="noopener noreferrer">ORCID: 0009-0008-1310-6169</a>), eliminating author ambiguity.
            </p>
          </div>
        </div>

        <!-- 6. SINTA Guidelines -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/sinta.png" alt="SINTA" />
          </div>
          <div class="index-details">
            <h3>SINTA &amp; National Accreditation Standards</h3>
            <p>
              Publication format, editorial structures, and peer review methodologies conform to Kemendikbudristek SINTA editorial standards for scientific periodicals.
            </p>
          </div>
        </div>

        <!-- 7. OpenAlex Global Scholarly Graph -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/openalex.svg" alt="OpenAlex" style="max-height: 38px;" />
          </div>
          <div class="index-details">
            <h3>OpenAlex Global Scholarly Graph</h3>
            <p>
              OpenAlex indexes JCFAD works, author entities, institutional affiliations, and concept taxonomies into the open citation graph used by AI discovery platforms worldwide.
            </p>
          </div>
        </div>

        <!-- 8. Semantic Scholar (Allen AI) -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/semanticscholar.svg" alt="Semantic Scholar" style="max-height: 38px;" />
          </div>
          <div class="index-details">
            <h3>Semantic Scholar (Allen Institute for AI)</h3>
            <p>
              AI-driven citation analysis, influential citation tracking, and automated TL;DR summaries for published research papers via machine-readable Highwire and DOI endpoints.
            </p>
          </div>
        </div>

        <!-- 9. Dimensions.ai -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/dimensions.svg" alt="Dimensions" style="max-height: 36px;" />
          </div>
          <div class="index-details">
            <h3>Dimensions (Digital Science)</h3>
            <p>
              Cross-disciplinary citation metrics, research grant tracking, and policy document linkages indexed via open DataCite and Crossref metadata feeds.
            </p>
          </div>
        </div>

        <!-- 10. BASE (Bielefeld Academic Search Engine) -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/base.svg" alt="BASE Bielefeld" style="max-height: 36px;" />
          </div>
          <div class="index-details">
            <h3>BASE (Bielefeld Academic Search Engine)</h3>
            <p>
              Operated by Bielefeld University Library (Germany), BASE harvests OAI-PMH compliant metadata and open-access full-text PDFs across global research repositories.
            </p>
          </div>
        </div>

        <!-- 11. Garuda Kemendikbudristek -->
        <div class="index-row-card">
          <div class="index-logo-wrapper">
            <img src="/images/indexes/garuda.svg" alt="Garuda" style="max-height: 38px;" />
          </div>
          <div class="index-details">
            <h3>Garuda (Garba Rujukan Digital - Kemendikbudristek / BRIN)</h3>
            <p>
              National Indonesian scientific digital repository and citation gateway preparing JCFAD for formal multi-tier national accreditation.
            </p>
          </div>
        </div>
      </div>

      <!-- AI Machine Readability Notice -->
      <div class="ai-indexer-box">
        <div class="ai-box-badge">AI DISCOVERY &amp; LLM INDEXING</div>
        <h3 class="ai-box-title">Machine-Readable Discovery Standard for LLMs</h3>
        <p class="ai-box-text">
          JCFAD implements the open web standard <code>llms.txt</code> allowing automated discovery, synthesis, and citation attribution by scientific AI agents including <strong>Consensus.app</strong>, <strong>Scite.ai</strong>, <strong>Elicit</strong>, <strong>Perplexity</strong>, and large multimodal language models.
        </p>
        <div class="ai-box-action">
          <a href="/llms.txt" target="_blank" class="ai-btn-view">Inspect /llms.txt Manifest &rarr;</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .classic-page-container {
    padding: 3rem 0 5rem;
    background: #ffffff;
    min-height: 75vh;
    font-family: Georgia, 'Times New Roman', serif;
    color: #111111;
  }

  .classic-page-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header-box {
    border-bottom: 2px solid #111111;
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .page-sup {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #dc2626;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 0.8rem;
    color: #000000;
  }

  .page-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #444444;
    margin: 0;
  }

  .index-full-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .index-row-card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid #222222;
    background: #fafafa;
    border-radius: 0 !important;
  }

  .index-logo-wrapper {
    flex-shrink: 0;
    width: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .index-logo-wrapper img {
    max-width: 100%;
    max-height: 50px;
    object-fit: contain;
  }

  .index-details h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: #111111;
  }

  .index-details p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #444444;
    margin: 0;
  }

  .index-details a {
    color: #000000;
    font-weight: 600;
    text-decoration: underline;
  }

  .ai-indexer-box {
    margin-top: 3rem;
    padding: 2rem;
    border: 2px solid #0f172a;
    background: #f8fafc;
  }

  .ai-box-badge {
    display: inline-block;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #ffffff;
    background: #0f172a;
    padding: 0.25rem 0.6rem;
    margin-bottom: 0.8rem;
  }

  .ai-box-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
    color: #0f172a;
  }

  .ai-box-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #334155;
    margin: 0 0 1.25rem;
  }

  .ai-box-text code {
    background: #e2e8f0;
    padding: 0.15rem 0.35rem;
    font-size: 0.9em;
    font-family: monospace;
    font-weight: 700;
  }

  .ai-btn-view {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: #0f172a;
    color: #ffffff !important;
    text-decoration: none !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    transition: background 0.15s ease;
  }

  .ai-btn-view:hover {
    background: #334155;
  }

  @media (max-width: 600px) {
    .index-row-card {
      flex-direction: column;
    }
    .index-logo-wrapper {
      width: 100%;
      justify-content: flex-start;
    }
    .ai-indexer-box {
      padding: 1.25rem;
    }
  }
</style>
