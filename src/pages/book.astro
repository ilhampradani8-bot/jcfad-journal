---
import Layout from '../layouts/Layout.astro';
import JournalHeader from '../components/JournalHeader.astro';
import Footer from '../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

// Load Blueprint from books/cache
let blueprint = {
  title: "Empati Sintetis: Psikologi Bahasa AI, Jerat Manipulasi Kognitif, dan Kedaulatan Hukum Individu",
  subtitle: "Kajian Lintas Disiplin Linguistik Komputasional, Bias Psikologis, dan Kedaulatan Mental",
  preface: "",
  chapters: []
};

try {
  const bpPath = path.resolve('./books/cache/empati-sintetis-buku-cetak/blueprint.json');
  if (fs.existsSync(bpPath)) {
    blueprint = JSON.parse(fs.readFileSync(bpPath, 'utf-8'));
  }
} catch (e) {
  console.warn("Could not load blueprint.json:", e.message);
}

const bookPdfUrl = "/books/empati-sintetis.pdf";
const bookTitle = blueprint.title;
const bookSubtitle = blueprint.subtitle;
const authorName = "Ilham Pradani";
const authorOrcid = "0009-0008-1310-6169";
const totalChapters = blueprint.chapters.length || 10;
const totalPages = 76;
const totalTables = 43;
const totalFormulas = 24;

// Automated Academic PDF Quality Engine Audit Results
const auditScore = "100.0%";
const auditStatus = "LULUS SEMPURNA (SIAP CETAK)";
const auditResults = [
  {
    category: "Ketebalan Monograf",
    status: "PASS",
    metric: "76 Halaman Penuh",
    desc: "Melampaui standar UNESCO (≥ 49 halaman) untuk monograf ilmiah komprehensif.",
    icon: "📄"
  },
  {
    category: "Standar Format Percetakan",
    status: "PASS",
    metric: "ISO-B5 (498.9 × 708.7 pt)",
    desc: "Standar fisik buku cetak internasional, margin gutter 2.5 cm, running headers & folio angka.",
    icon: "📐"
  },
  {
    category: "Kelengkapan 10 Bab",
    status: "PASS",
    metric: "100% Bab Terverifikasi",
    desc: "Seluruh Bab 1 s/d 10 utuh, tanpa teks terpotong, memuat analisis empiris dan kajian hukum.",
    icon: "📚"
  },
  {
    category: "Integritas Render Tabel",
    status: "PASS",
    metric: "43 Tabel Booktabs",
    desc: "0 kebocoran pipa teks mentah (| | |). Terformat rapi menggunakan standar percetakan tiga garis.",
    icon: "📊"
  },
  {
    category: "Tipografi Notasi Rumus",
    status: "PASS",
    metric: "24 Display Math Bersih",
    desc: "Rumus matematis terpusat dengan spasi vertikal murni, bebas dari card / box abu-abu AI generik.",
    icon: "🧮"
  },
  {
    category: "Hak Cipta & ORCID",
    status: "PASS",
    metric: "Ilham Pradani (Verified)",
    desc: "ORCID 0009-0008-1310-6169 dan afiliasi PT CHAIN ASIA CONECT terpasang resmi di colophon.",
    icon: "🔏"
  }
];

// Schema.org for Scholarly Book
const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  "name": bookTitle,
  "headline": bookSubtitle,
  "author": {
    "@type": "Person",
    "name": authorName,
    "identifier": `https://orcid.org/${authorOrcid}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "PT CHAIN ASIA CONECT Research & Development Division",
    "url": "https://chainasiaconnect.co.id"
  },
  "datePublished": "2026-11-08",
  "inLanguage": "id",
  "numberOfPages": totalPages,
  "bookFormat": "https://schema.org/EBook",
  "url": "https://journal.chainasiaconnect.co.id/book"
};
---

<Layout
  title={`${bookTitle} | JCFAD Scholarly Monograph`}
  description={`${bookSubtitle} — Monograf riset lengkap 10 bab karya ${authorName} berstandar buku cetak ISO-B5.`}
  canonical="https://journal.chainasiaconnect.co.id/book"
>
  <JournalHeader />

  <main class="book-page-container">
    <div class="container book-inner">
      <!-- Breadcrumb & Header Box -->
      <div class="book-header-box">
        <div class="book-sup-badge">
          <span>📚 PT CHAIN ASIA CONECT MONOGRAPH SERIES</span>
          <span class="badge-dot">•</span>
          <span>OPEN ACCESS BOOK</span>
          <span class="badge-dot">•</span>
          <span>PRINT-READY ISO-B5</span>
        </div>

        <h1 class="book-title">{bookTitle}</h1>
        <p class="book-subtitle">{bookSubtitle}</p>

        <!-- Author Card & Metadata -->
        <div class="book-meta-grid">
          <div class="meta-item author-item">
            <span class="meta-label">Penulis Utama</span>
            <div class="author-info">
              <strong>{authorName}</strong>
              <a href={`https://orcid.org/${authorOrcid}`} target="_blank" rel="noopener noreferrer" class="orcid-badge">
                <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor">
                  <path d="M128,0A128,128,0,1,0,256,128,128,128,0,0,0,128,0ZM86.3,186.2H70.9V74.8h15.4ZM78.6,60.9a10.4,10.4,0,1,1,10.4-10.4A10.4,10.4,0,0,1,78.6,60.9Zm104.5,75.4c0,29.9-20.2,49.9-52.5,49.9H107.5V74.8h25.8C165.2,74.8,183.1,95.5,183.1,136.3Zm-59.2,35.2h18.2c22.1,0,36.5-13.6,36.5-35.2s-14.4-35.3-36.5-35.3H123.9Z" fill="#a6ce39"/>
                </svg>
                ORCID: {authorOrcid}
              </a>
            </div>
          </div>

          <div class="meta-item">
            <span class="meta-label">Penerbit & Afiliasi</span>
            <span class="meta-val">PT CHAIN ASIA CONECT Research Division</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Format & Tebal</span>
            <span class="meta-val">{totalChapters} Bab • {totalPages} Halaman (ISO-B5)</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Aksesibilitas</span>
            <span class="meta-val text-green">Open Access Full PDF (Gratis)</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="book-cta-bar">
          <a href={bookPdfUrl} download="empati-sintetis-ilham-pradani-print-ready.pdf" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Unduh PDF Buku (76 Halaman)
          </a>

          <a href={bookPdfUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Buka PDF di Tab Baru
          </a>

          <a href="#audit-review" class="btn btn-outline">
            Audit Mutu & Standar PDF (100%) ↓
          </a>

          <a href="#daftar-isi" class="btn btn-outline">
            Daftar Isi 10 Bab ↓
          </a>
        </div>
      </div>

      <!-- Academic Quality & PDF Audit Review Section -->
      <section id="audit-review" class="audit-review-section">
        <div class="audit-header">
          <div class="audit-title-wrap">
            <span class="audit-eyebrow">🔬 JCFAD ACADEMIC QUALITY ENGINE</span>
            <h2>Sertifikasi & Audit Mutu Naskah Buku</h2>
          </div>
          <div class="audit-score-badge">
            <span class="score-num">{auditScore}</span>
            <span class="score-label">{auditStatus}</span>
          </div>
        </div>

        <p class="audit-summary">
          Naskah buku ini telah melalui automated pre-flighting 6 dimensi kualitas standar percetakan monograf akademik internasional (UNESCO Monograph Guidelines & ISO-B5 Book Publishing Standards):
        </p>

        <div class="audit-grid">
          {auditResults.map((item) => (
            <div class="audit-card">
              <div class="audit-card-top">
                <span class="audit-icon">{item.icon}</span>
                <span class="audit-status-pill">{item.status}</span>
              </div>
              <h4 class="audit-cat">{item.category}</h4>
              <div class="audit-metric">{item.metric}</div>
              <p class="audit-desc">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="audit-footer-note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span>
            <strong>Validasi Typst Compiler:</strong> Memverifikasi <strong>{totalTables} tabel berstandar Booktabs</strong> (tanpa pipa mentah) dan <strong>{totalFormulas} rumus display math terpusat</strong> dengan spasi vertikal murni (bebas dari card AI generik).
          </span>
        </div>
      </section>

      <!-- Embedded PDF Viewer -->
      <section class="viewer-section">
        <div class="viewer-header">
          <h2>Pembaca Buku Digital (Interactive Reader)</h2>
          <span class="viewer-tip">Gunakan kontrol di dalam viewer untuk zoom, navigasi halaman, atau layar penuh.</span>
        </div>

        <div class="pdf-container">
          <iframe
            src={`${bookPdfUrl}#toolbar=1&navpanes=1&scrollbar=1`}
            title={bookTitle}
            width="100%"
            height="750px"
            class="embedded-pdf-frame"
          >
            <p>
              Browser Anda tidak mendukung preview PDF langsung. 
              <a href={bookPdfUrl} target="_blank">Klik di sini untuk mengunduh dan membaca berkas PDF</a>.
            </p>
          </iframe>
        </div>
      </section>

      <!-- Preface & Synopsis -->
      {blueprint.preface && (
        <section class="preface-section">
          <h2>Prakata Penulis</h2>
          <div class="preface-body">
            {blueprint.preface.split('\n\n').map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>
      )}

      <!-- Table of Contents Breakdown -->
      <section id="daftar-isi" class="toc-section">
        <h2>Daftar Isi & Rangkuman 10 Bab</h2>
        <p class="toc-desc">
          Buku ini disusun secara berkesinambungan melalui metodologi lintas disiplin linguistik komputasional, psikologi kognitif, dan doktrin hukum kedaulatan mental:
        </p>

        <div class="chapters-accordion">
          {blueprint.chapters.map((ch) => (
            <div class="chapter-card">
              <div class="chapter-card-header">
                <span class="ch-badge">BAB {ch.number}</span>
                <h3 class="ch-title">{ch.title}</h3>
              </div>
              <p class="ch-focus"><strong>Fokus Pembahasan:</strong> {ch.focus}</p>

              {ch.subchapters && ch.subchapters.length > 0 && (
                <div class="ch-sublist">
                  <strong>Sub-bab Utama:</strong>
                  <ul>
                    {ch.subchapters.map((sub) => (
                      <li>{sub}</li>
                    ))}
                  </ul>
                </div>
              )}

              {ch.empiricalCases && (
                <div class="ch-cases">
                  <span class="cases-label">Studi Kasus & Pembuktian Empiris:</span>
                  <span class="cases-text">{ch.empiricalCases}</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Bottom Download Box -->
      <section class="bottom-download-box">
        <h3>Miliki Versi Cetak / PDF Lengkap Sekarang</h3>
        <p>Buku ini dirilis di bawah lisensi Open Science (Creative Commons BY 4.0) untuk kepentingan riset, sitasi akademik, dan edukasi publik.</p>
        <div class="bottom-btns">
          <a href={bookPdfUrl} download="empati-sintetis-ilham-pradani-print-ready.pdf" class="btn btn-primary">
            Unduh Naskah Lengkap (76 Halaman PDF)
          </a>
          <a href="/" class="btn btn-outline">
            Kembali ke Beranda Jurnal JCFAD
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
</Layout>

<style>
  .book-page-container {
    background-color: #0b0f19;
    color: #e2e8f0;
    min-height: 100vh;
    padding: 3rem 0 5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .book-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header Box */
  .book-header-box {
    background: linear-gradient(180deg, #131c2e 0%, #0f172a 100%);
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 2.5rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  }

  .book-sup-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 0.35rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid rgba(56, 189, 248, 0.25);
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    color: #64748b;
  }

  .book-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: #f8fafc;
    margin-bottom: 0.75rem;
  }

  .book-subtitle {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Meta Grid */
  .book-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid #1e293b;
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .meta-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    font-weight: 600;
  }

  .meta-val {
    font-size: 0.95rem;
    color: #cbd5e1;
    font-weight: 500;
  }

  .text-green {
    color: #34d399;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .orcid-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #a6ce39;
    text-decoration: none;
  }

  .orcid-badge:hover {
    text-decoration: underline;
  }

  /* CTA Bar */
  .book-cta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: #0284c7;
    color: #ffffff;
    border: 1px solid #38bdf8;
  }

  .btn-primary:hover {
    background: #0369a1;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
  }

  .btn-secondary {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
  }

  .btn-secondary:hover {
    background: #334155;
    color: #ffffff;
  }

  .btn-outline {
    background: transparent;
    color: #94a3b8;
    border: 1px solid #334155;
  }

  .btn-outline:hover {
    color: #f8fafc;
    border-color: #64748b;
  }

  /* Audit Review Section */
  .audit-review-section {
    background: linear-gradient(180deg, #0e1726 0%, #0a0f1d 100%);
    border: 1px solid #1e2d4a;
    border-radius: 12px;
    padding: 2.25rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  }

  .audit-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #1e293b;
    margin-bottom: 1.25rem;
  }

  .audit-eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #10b981;
    margin-bottom: 0.35rem;
  }

  .audit-title-wrap h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0;
  }

  .audit-score-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
  }

  .score-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: #34d399;
  }

  .score-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #6ee7b7;
    text-transform: uppercase;
  }

  .audit-summary {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #94a3b8;
    margin-bottom: 1.75rem;
  }

  .audit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .audit-card {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .audit-card:hover {
    transform: translateY(-2px);
    border-color: #334155;
  }

  .audit-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .audit-icon {
    font-size: 1.35rem;
  }

  .audit-status-pill {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .audit-cat {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0 0 0.35rem;
  }

  .audit-metric {
    font-size: 0.85rem;
    font-weight: 600;
    color: #38bdf8;
    margin-bottom: 0.5rem;
  }

  .audit-desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: #94a3b8;
    margin: 0;
  }

  .audit-footer-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.25);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    font-size: 0.85rem;
    color: #bae6fd;
    line-height: 1.5;
  }

  .audit-footer-note svg {
    color: #38bdf8;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* Viewer Section */
  .viewer-section {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .viewer-header {
    margin-bottom: 1rem;
  }

  .viewer-header h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 0.25rem;
  }

  .viewer-tip {
    font-size: 0.85rem;
    color: #64748b;
  }

  .pdf-container {
    background: #020617;
    border: 1px solid #1e293b;
    border-radius: 8px;
    overflow: hidden;
  }

  .embedded-pdf-frame {
    border: none;
    display: block;
  }

  /* Preface Section */
  .preface-section {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .preface-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1e293b;
  }

  .preface-body p {
    font-size: 1.025rem;
    line-height: 1.8;
    color: #cbd5e1;
    margin-bottom: 1.25rem;
  }

  /* TOC Section */
  .toc-section {
    margin-bottom: 3rem;
  }

  .toc-section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 0.5rem;
  }

  .toc-desc {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .chapters-accordion {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .chapter-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 1.75rem;
    transition: border-color 0.2s ease;
  }

  .chapter-card:hover {
    border-color: #38bdf8;
  }

  .chapter-card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .ch-badge {
    background: rgba(56, 189, 248, 0.15);
