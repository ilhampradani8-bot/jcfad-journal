---
import Layout from '../layouts/Layout.astro';
import JournalHeader from '../components/JournalHeader.astro';
import Footer from '../components/Footer.astro';
import { fetchAllNews, formatImageUrl, parseDateToISO, renderArticleContentHtml, decodeHtmlEntities, cleanContentText, parseMarkdownTableHtml, isAcademicItem } from '../lib/news';
import { getArticleVersionData } from '../lib/versions';
import versionsV1Data from '../data/versions_v1.json';
import osfRecordsData from '../data/osf_records.json';

export async function getStaticPaths() {
  const { news } = await fetchAllNews();
  const paths = [];
  const academicItems = (news || []).filter((item: any) => isAcademicItem(item));
  for (const item of academicItems) {
    // Generate route for SEO Title Slug
    paths.push({
      params: { slug: item.slug },
      props: { article: item, allNews: news }
    });
    // Juga dukung route numeric id agar backwards-compatible
    if (item.id && item.id !== item.slug) {
      paths.push({
        params: { slug: String(item.id) },
        props: { article: item, allNews: news }
      });
    }
  }
  return paths;
}

const { slug } = Astro.params;

// Ambil data terbaru secara live dan dinamis langsung dari Cloudflare D1
const { news } = await fetchAllNews();
const article = news.find((n: any) => n.slug === slug || String(n.id) === String(slug)) || Astro.props.article;

if (!article) {
  return Astro.redirect('/');
}

const isAcademicPaper = isAcademicItem(article);

// Canonical URL SEO ramah Google & Google Scholar (murni mengarah ke subdomain jurnal tanpa /newsroom/ untuk paper ilmiah)
const canonicalUrl = isAcademicPaper
  ? `https://journal.chainasiaconnect.co.id/${article.slug}`
  : `https://www.chainasiaconnect.co.id/newsroom/${article.slug}`;

// Pastikan gambar artikel menggunakan URL dinamis yang valid
const dynamicArticleImage = formatImageUrl(article.imageUrl);

// Konversi tanggal berita ke format standar ISO 8601 untuk Google News & Search Console
const isoPublishedDate = parseDateToISO(article.date);

// Filter saran berita terpisah (Rilis Korporasi vs Naskah Ilmiah)
const corporateSuggestions = news
  .filter((n) => !isAcademicItem(n) && n.slug !== article.slug && String(n.id) !== String(article.id))
  .slice(0, 3);

const academicSuggestions = news
  .filter((n) => isAcademicItem(n) && n.slug !== article.slug && String(n.id) !== String(article.id))
  .slice(0, 4);

const suggestions = isAcademicPaper ? academicSuggestions : corporateSuggestions;

// Format dan parse konten artikel (membersihkan format markdown ***, **, &amp;, dll)
const rawContent = article.content && article.content.trim().length > 0 ? article.content : article.excerpt;
const parsedBlocks = renderArticleContentHtml(rawContent);
const cleanTitle = decodeHtmlEntities(article.title);
const cleanExcerpt = cleanContentText(article.excerpt);

// Riwayat Versi & Concept DOI (Zenodo CERN Architecture)
const initialDoi = article.doi || '10.5281/zenodo.14022601';
const versionData = getArticleVersionData(article.slug, initialDoi);
const currentV1 = ((versionsV1Data as Record<string, any>) || {})[article.slug] || null;
const parsedBlocksV1 = currentV1 ? renderArticleContentHtml(currentV1.body) : [];
const osfRecord = ((osfRecordsData as Record<string, any>) || {})[article.slug] || null;
const hasMultipleVersions = Boolean(isAcademicPaper && versionData && versionData.versions && versionData.versions.length > 1);
const v2Item = versionData?.versions?.find((v: any) => v.versionNum === '2') || versionData?.versions?.[0];
const v1Item = versionData?.versions?.find((v: any) => v.versionNum === '1') || versionData?.versions?.[versionData.versions.length - 1];

// Utamakan DOI Versi 2 jika tersedia (biasanya ada 2 DOI: v1/concept dan v2), fallback ke initialDoi
const articleDoi = v2Item?.doi || initialDoi;

// Dokumen PDF Naskah Ilmiah (Sesuai dengan artikel yang sedang dilihat)
const articlePdfFilename = `${article.slug}.pdf`;
const articlePdfPath = `/docs/${articlePdfFilename}?v=20261107-v5`;

// Helper untuk path PDF per versi
const getVersionPdfPath = (vNum: string, isLatestVer: boolean) => {
  if (isLatestVer) return `/docs/${article.slug}.pdf`;
  if (String(vNum) === '1') return (currentV1 && currentV1.pdfUrl) || `/docs/v1/${article.slug}.pdf`;
  if (String(vNum) === '2') return `/docs/v2/${article.slug}.pdf`;
  if (String(vNum) === '3') return `/docs/v3/${article.slug}.pdf`;
  return `/docs/${article.slug}.pdf`;
};

// Parse author(s) - mendukung single author maupun multi-penulis dipisahkan koma (membersihkan nama wakil & cand)
const cleanAuthorItem = (name: string) => {
  return name
    .replace(/,\s*S\.H\.\s*\(Cand\.\)/gi, '')
    .replace(/\(Cand\.\)/gi, '')
    .replace(/Wakil\s+Direktur\s+Utama/gi, '')
    .replace(/Wakil\s+Direktur/gi, '')
    .trim();
};

const rawAuthors = (article.author || 'Ilham Pradani')
  .split(/[,;]/)
  .map((a: string) => cleanAuthorItem(a))
  .filter((a: string) => a.length > 0 && !/putri|wulan|wakil/i.test(a));
const displayAuthors = rawAuthors.length > 0 ? rawAuthors : ['Ilham Pradani'];
const isSolo = displayAuthors.length === 1;

// Helper untuk format sitasi APA
function formatApaAuthors(authors: string[]): string {
  const formatted = authors.map((name) => {
    const parts = name.split(/\s+/).filter(Boolean);
    if (parts.length === 1) return parts[0];
    const last = parts[parts.length - 1];
    const initials = parts.slice(0, -1).map(p => p[0].toUpperCase() + '.').join(' ');
    return `${last}, ${initials}`;
  });
  if (formatted.length === 1) return formatted[0];
  if (formatted.length === 2) return `${formatted[0]} & ${formatted[1]}`;
  return `${formatted.slice(0, -1).join(', ')}, & ${formatted[formatted.length - 1]}`;
}

const apaAuthors = formatApaAuthors(displayAuthors);
const bibtexAuthors = displayAuthors.join(' and ');
const primaryAuthorLastName = (displayAuthors[0].split(/\s+/).pop() || 'Pradani').replace(/[^a-zA-Z0-9]/g, '');
const articleDownloadName = `${article.slug}-${primaryAuthorLastName}.pdf`;

// Helper untuk riwayat naskah dinamis (Received, Revised, Accepted, Published)
function getDynamicHistory(dateStr: string) {
  const monthMap: Record<string, number> = {
    'januari': 0, 'februari': 1, 'maret': 2, 'april': 3, 'mei': 4, 'juni': 5,
    'juli': 6, 'agustus': 7, 'september': 8, 'oktober': 9, 'november': 10, 'desember': 11,
    'jan': 0, 'feb': 1, 'mar': 2, 'apr': 3, 'may': 4, 'jun': 5,
    'jul': 6, 'aug': 7, 'sep': 8, 'oct': 9, 'nov': 10, 'dec': 11
  };
  let pubDate = new Date(2026, 10, 4);
  if (dateStr) {
    const parts = dateStr.toLowerCase().split(/\s+/);
    if (parts.length >= 3 && !isNaN(parseInt(parts[0], 10)) && !isNaN(parseInt(parts[2], 10))) {
      const d = parseInt(parts[0], 10);
      const m = monthMap[parts[1]] ?? 10;
      const y = parseInt(parts[2], 10);
      pubDate = new Date(y, m, d);
    } else if (dateStr.includes('-')) {
      const [y, m, d] = dateStr.split('-').map(Number);
      pubDate = new Date(y, (m || 11) - 1, d || 1);
    }
  }

  const accepted = new Date(pubDate.getTime() - 12 * 86400000);
  const revised = new Date(accepted.getTime() - 22 * 86400000);
  const received = new Date(revised.getTime() - 35 * 86400000);

  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const fmt = (dt: Date) => `${String(dt.getDate()).padStart(2, '0')} ${months[dt.getMonth()]} ${dt.getFullYear()}`;

  return {
    received: fmt(received),
    revised: fmt(revised),
    accepted: fmt(accepted),
    published: fmt(pubDate)
  };
}

const historyDates = getDynamicHistory(article.date);

const referencesList = (article.references && article.references.length > 0)
  ? article.references
  : [
      'Kementerian Hukum dan HAM Republik Indonesia (Kemenkumham RI). Keputusan Pengesahan Badan Hukum PT CHAIN ASIA CONECT No. AHU-A117353.AH.01.30.Tahun 2026.',
      'Kementerian Investasi / BKPM RI. Nomor Induk Berusaha (NIB) 0709260109599, KBLI 62193 & NPWP 10.000.000.1-094.6336.',
      'Badan Pusat Statistik (BPS) Provinsi Lampung & Kabupaten Pesisir Barat. Analisis Sektor Rantai Pasok dan Industri Akomodasi Pariwisata.',
      'Otoritas Jasa Keuangan (OJK). POJK No. 31/POJK.04/2021 tentang Penerapan Tata Kelola Perusahaan Terbuka (Good Corporate Governance).'
    ];

// Format Sitasi Baku Akademis (APA 7th & BibTeX) untuk ResearchGate & Google Scholar
const apaCitationText = `${apaAuthors} (2026). ${cleanTitle}. Journal of Coastal Frontiers & Applied Development (JCFAD), 1(1), 1–12. https://doi.org/${articleDoi}`;

const versionsMap: Record<string, any> = {};
if (hasMultipleVersions && versionData && versionData.versions) {
  for (const v of versionData.versions) {
    const isV1 = String(v.versionNum) === '1';
    const isLatest = Boolean(v.isLatest);
    const pdfPath = getVersionPdfPath(v.versionNum, isLatest);
    versionsMap[v.versionNum] = {
      versionNum: v.versionNum,
      versionLabel: v.version || `Version ${v.versionNum}`,
      title: isV1 ? ((currentV1 && currentV1.title) || cleanTitle) : cleanTitle,
      abstract: isV1 ? ((currentV1 && currentV1.abstract) || cleanExcerpt) : cleanExcerpt,
      doi: v.doi,
      date: v.date || '07 Nov 2026',
      pdfUrl: pdfPath,
      isLatest: isLatest,
      citation: `${apaAuthors} (2026). ${isV1 ? ((currentV1 && currentV1.title) || cleanTitle) : cleanTitle}. Journal of Coastal Frontiers & Applied Development (JCFAD)${isV1 ? ' Working Paper Series' : ''}, 1(1), 1–12. https://doi.org/${v.doi}`
    };
  }
}

const clientVersionPayload = {
  hasMultipleVersions,
  conceptDoi: versionData.conceptDoi,
  currentVersion: hasMultipleVersions ? (versionData.currentVersion || '4') : '1',
  versionsMap
};
const bibtexCitationText = `@article{${primaryAuthorLastName.toLowerCase()}2026_${article.slug.replace(/[^a-zA-Z0-9]/g, '_').slice(0, 20)},
  author = {${bibtexAuthors}},
  title = {${cleanTitle}},
  journal = {Journal of Coastal Frontiers \\& Applied Development (JCFAD)},
  volume = {1},
  number = {1},
  pages = {1--12},
  year = {2026},
  publisher = {PT CHAIN ASIA CONECT Research \\& Development Division},
  doi = {${articleDoi}},
  url = {${canonicalUrl}}
}`;

// Rich Schema.org ScholarlyArticle & NewsArticle Structured Data untuk Google Search & Google Scholar
const scholarlyArticleSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "@id": `${canonicalUrl}#article`,
  "headline": cleanTitle,
  "name": cleanTitle,
  "description": cleanExcerpt,
  "image": [dynamicArticleImage],
  "datePublished": isoPublishedDate,
  "dateModified": isoPublishedDate,
  "inLanguage": ["en", "id"],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "isAccessibleForFree": true,
  "citation": (referencesList || []).map(r => r.replace(/<[^>]*>/g, '').trim()),
  "identifier": [
    {
      "@type": "PropertyValue",
      "propertyID": "DOI",
      "value": articleDoi
    },
    `https://doi.org/${articleDoi}`
  ],
  "sameAs": `https://doi.org/${articleDoi}`,
  "url": canonicalUrl,
  "pageStart": "1",
  "pageEnd": "12",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": [
    ...displayAuthors.map((name, idx) => ({
      "@type": "Person",
      "name": name,
      "identifier": "https://orcid.org/0009-0008-1310-6169",
      "sameAs": "https://orcid.org/0009-0008-1310-6169",
      ...(idx === 0 ? { "jobTitle": "Lead Researcher & Editor-in-Chief" } : { "jobTitle": "Co-Researcher / Author" }),
      "affiliation": {
        "@type": "Organization",
        "name": "Research & Development Division, PT CHAIN ASIA CONECT",
        "url": "https://journal.chainasiaconnect.co.id"
      }
    }))
  ],
  "publisher": {
    "@type": "Organization",
    "name": "PT CHAIN ASIA CONECT Research & Development Division",
    "url": "https://journal.chainasiaconnect.co.id",
    "logo": {
      "@type": "ImageObject",
      "url": "https://journal.chainasiaconnect.co.id/images/jcfad-seal.png"
    }
  },
  "isPartOf": {
    "@type": "PublicationIssue",
    "issueNumber": "1",
    "datePublished": "2026-11",
    "isPartOf": {
      "@type": "PublicationVolume",
      "volumeNumber": "1",
      "isPartOf": {
        "@type": "Periodical",
        "@id": "https://journal.chainasiaconnect.co.id/#periodical",
        "name": "Journal of Coastal Frontiers & Applied Development",
        "alternateName": "JCFAD",
        "url": "https://journal.chainasiaconnect.co.id"
      }
    }
  },
  "associatedMedia": {
    "@type": "MediaObject",
    "contentUrl": `https://journal.chainasiaconnect.co.id${articlePdfPath}`,
    "encodingFormat": "application/pdf"
  },
  "about": [
    "Pesisir Barat Regional Economics",
    "Remote Frontier Development",
    "Krui Pesisir Barat",
    "Commercial Contract Certainty",
    "Applied Jurisprudence"
  ]
};

// Rich Schema.org NewsArticle Structured Data untuk Berita Korporasi
const newsArticleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "@id": `${canonicalUrl}#article`,
  "headline": cleanTitle,
  "name": cleanTitle,
  "description": cleanExcerpt,
  "image": [dynamicArticleImage],
  "datePublished": isoPublishedDate,
  "dateModified": isoPublishedDate,
  "inLanguage": "id",
  "url": canonicalUrl,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Organization",
    "name": article.author || "PT CHAIN ASIA CONECT",
    "url": "https://www.chainasiaconnect.co.id"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PT CHAIN ASIA CONECT",
    "url": "https://www.chainasiaconnect.co.id",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.chainasiaconnect.co.id/images/CAC-LOGO.jpg"
    }
  }
};

---

<Layout 
  title={isAcademicPaper ? `${cleanTitle} | Journal of Coastal Frontiers & Applied Development (JCFAD)` : `${cleanTitle} | Newsroom PT CHAIN ASIA CONECT`}
  description={cleanExcerpt}
  canonical={canonicalUrl}
  image={dynamicArticleImage}
  ogType="article"
  articleMeta={{
    publishedTime: isoPublishedDate,
    author: displayAuthors.join(', '),
    section: article.tag
  }}
  scholarlyMeta={isAcademicPaper ? {
    title: cleanTitle,
    authors: displayAuthors,
    publicationDate: isoPublishedDate,
    doi: articleDoi,
    journalTitle: "Journal of Coastal Frontiers & Applied Development",
    issn: "",
    abstract: cleanExcerpt,
    pdfUrl: `https://journal.chainasiaconnect.co.id${articlePdfPath}`,
    references: referencesList,
    language: "en"
  } : undefined}
  extraSchema={isAcademicPaper ? scholarlyArticleSchema : newsArticleSchema}
>
  <JournalHeader />

  <main class="reading-page-main">
    <!-- Top Nav & Breadcrumb Bar -->
    <nav class="reading-nav-bar" aria-label="Navigasi">
      <div class="container nav-bar-inner">
        {isAcademicPaper ? (
          <a href="https://journal.chainasiaconnect.co.id" class="back-link">
            <svg viewBox="0 0 20 20" fill="currentColor" class="nav-arrow">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
            </svg>
            <span>&larr; Back to Journal Table of Contents</span>
          </a>
        ) : (
          <a href="/newsroom" class="back-link">
            <svg viewBox="0 0 20 20" fill="currentColor" class="nav-arrow">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
            </svg>
            <span>Kembali ke Newsroom</span>
          </a>
        )}

        <div class="breadcrumb-trail">
          {isAcademicPaper ? (
            <>
              <a href="https://journal.chainasiaconnect.co.id">Journal Home</a>
              <span class="sep">/</span>
              <a href="https://journal.chainasiaconnect.co.id#current-issue">Vol. 1 No. 1 (2026)</a>
              <span class="sep">/</span>
              <span class="current-crumb">Empirical Paper</span>
            </>
          ) : (
            <>
              <a href="/">Beranda</a>
              <span class="sep">/</span>
              <a href="/newsroom">Newsroom</a>
              <span class="sep">/</span>
              <span class="current-crumb">{article.tag}</span>
            </>
          )}
        </div>
      </div>
    </nav>

    <!-- Floating PDF Action (Hanya Tampil Pada Naskah Ilmiah JCFAD) -->
    {isAcademicPaper && (
      <aside class="floating-pdf-dock" aria-label="Unduh Naskah PDF">
        <a href={articlePdfPath} target="_blank" download={articleDownloadName} class="btn-floating-pdf" title="Unduh Dokumen PDF Resmi">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span class="floating-pdf-text">Unduh PDF</span>
        </a>
      </aside>
    )}

    {isAcademicPaper ? (
      <!-- ════════════════════════════════════════════════════════════════ -->
      <!-- 🏛️ JCFAD ACADEMIC SCHOLARLY PAPER WORKSPACE (SUBDOMAIN JOURNAL) -->
      <!-- ════════════════════════════════════════════════════════════════ -->
      <div class="scholarly-workspace-wrapper">
        <div class="scholarly-workspace-layout">
          
          <!-- ── LEFT COLUMN: FROZEN / STICKY ACADEMIC SIDEBAR ── -->
          <aside class="journal-sticky-sidebar" id="journal-sticky-sidebar" aria-label="Sidebar Navigasi Naskah &amp; Versi">
            
            <!-- 1. Frozen Back & Actions Section -->
            <div class="sidebar-frozen-nav-card">
              <a href="https://journal.chainasiaconnect.co.id" class="sidebar-frozen-back-btn" title="Kembali ke Daftar Isi Jurnal (Table of Contents)">
                <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                  <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                </svg>
                <span>&larr; Index Jurnal JCFAD</span>
              </a>

              <a href={articlePdfPath} target="_blank" download={articleDownloadName} class="sidebar-btn-pdf-download" title="Unduh File Resmi Galley PDF">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Unduh Galley PDF</span>
              </a>
            </div>

            <!-- 2. Navigasi / Daftar Isi Naskah (Table of Contents) -->
            <div class="sidebar-toc-panel">
              <span class="sidebar-toc-kicker">NAVIGASI NASKAH</span>
              <nav class="sidebar-toc-nav" aria-label="Daftar Isi Naskah">
                <a href="#abstrak" class="sidebar-toc-link">
                  <span class="toc-bullet">&bull;</span>
                  <span>Abstrak &amp; Kata Kunci</span>
                </a>
                <a href="#pembaca-pdf" class="sidebar-toc-link">
                  <span class="toc-bullet">&bull;</span>
                  <span>Pembaca PDF Naskah</span>
                </a>
                <a href="#naskah-prose" class="sidebar-toc-link">
                  <span class="toc-bullet">&bull;</span>
                  <span>Naskah Lengkap (IMRAD)</span>
                </a>
                <a href="#pustaka" class="sidebar-toc-link">
                  <span class="toc-bullet">&bull;</span>
                  <span>Daftar Pustaka Primer</span>
                </a>
                <a href="#sitasi-akademik" class="sidebar-toc-link">
                  <span class="toc-bullet">&bull;</span>
                  <span>Sitasi &amp; Format Rujukan</span>
                </a>
              </nav>
            </div>

            <!-- 3. Sticky Version Switcher Panel (Hanya Muncul Jika Multi-Versi) -->
            {hasMultipleVersions && (
              <div class="sidebar-versions-panel">
                <div class="sb-panel-header">
                  <span class="sb-kicker">CERN ZENODO REGISTRY</span>
                  <h3 class="sb-title">Riwayat Versi Naskah</h3>
                </div>

                <div class="sidebar-versions-list" id="sidebar-version-buttons">
                  {versionData.versions.map((ver: any) => (
                    <button
                      type="button"
                      class={`sidebar-version-item-btn ${ver.isLatest ? 'is-latest active' : 'is-archived'}`}
                      data-version-target={ver.versionNum}
                      title={`Klik untuk memuat dan membaca ${ver.version}`}
                    >
                      <div class="sb-v-top-row">
                        <span class="sb-v-badge-name">{ver.version}</span>
                        {ver.isLatest ? (
                          <span class="sb-badge-tag-latest">LATEST</span>
                        ) : (
                          <span class="sb-badge-tag-archived">ARCHIVED</span>
                        )}
                      </div>
                      <div class="sb-v-doi-row">doi:{ver.doi}</div>
                      <div class="sb-v-date-row">{ver.date}</div>
                      <div class="sb-v-click-indicator">
                        <span class="sb-dot-indicator"></span>
                        <span class="sb-indicator-text">{ver.isLatest ? '● Naskah Aktif Ditampilkan' : '↗ Muat Naskah Versi Ini'}</span>
                      </div>
                    </button>
                  ))}
                </div>

                <div class="sidebar-concept-doi-wrap">
                  <span class="sb-c-label">Concept DOI (Sitasi Semua Versi):</span>
                  <a href={`https://doi.org/${versionData.conceptDoi}`} target="_blank" rel="noopener noreferrer" class="sb-c-link">
                    <code>{versionData.conceptDoi}</code> ↗
                  </a>
                </div>
              </div>
            )}

          </aside>

        <!-- ── RIGHT COLUMN: ARTICLE MAIN COLUMN ── -->
        <article class="article-main-column" itemscope itemtype={isAcademicPaper ? "https://schema.org/ScholarlyArticle" : "https://schema.org/NewsArticle"}>
          
          <!-- Header Info Minimalist & Tajam (Standar Repositori Ilmiah Internasional) -->
          <header class="article-header-sharp">

            <!-- Full-Width Classic Scholarly Header (Batas Garis Saja, Tanpa Card, Tanpa Garis Kiri) -->
            <div class="academic-hero-fullwidth">
              
              <!-- 1. Journal Masthead (Full-Width, Dual Top & Bottom Black Hairlines) -->
              <div class="journal-classic-masthead-full">
