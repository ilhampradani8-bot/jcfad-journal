    background: #f8fafc;
    border-color: #0f172a;
  }

  .version-item-btn.active {
    border: 2px solid #111111;
    border-left: 2px solid #111111;
    background: #fafafa;
    box-shadow: none;
  }

  .version-item-btn.is-archived.active {
    border: 2px solid #111111;
    border-left: 2px solid #111111;
    background: #fafafa;
    box-shadow: none;
  }

  .version-item-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }

  .version-name {
    font-size: 0.78rem;
    font-weight: 800;
    color: #0f172a;
  }

  .badge-ver-latest {
    font-size: 0.6rem;
    font-weight: 800;
    color: #ffffff;
    background: #111111;
    padding: 1px 6px;
    letter-spacing: 0.04em;
  }

  .badge-ver-archived {
    font-size: 0.6rem;
    font-weight: 700;
    color: #475569;
    border: 1px solid #cbd5e1;
    padding: 0 5px;
    letter-spacing: 0.04em;
  }

  .version-date {
    font-size: 0.68rem;
    color: #64748b;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  .version-doi-row {
    margin-bottom: 0.25rem;
  }

  .version-doi-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    color: #0f172a;
    word-break: break-all;
  }

  .version-notes {
    font-size: 0.7rem;
    color: #475569;
