                <img src="/images/indexes/scopus.png" alt="Scopus" class="right-sb-logo-img scopus-img" />
              </a>
              <a href="https://zenodo.org" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card" title="CERN Zenodo Open Science Repository">
                <img src="/images/indexes/zenodo.png" alt="Zenodo" class="right-sb-logo-img" />
              </a>
              <a href="https://crossref.org" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card" title="Crossref Official Metadata Registry">
                <img src="/images/indexes/crossref.png" alt="Crossref" class="right-sb-logo-img" />
              </a>
              <a href="https://scholar.google.com" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card" title="Google Scholar Academic Metrics">
                <img src="/images/indexes/google-scholar.webp" alt="Google Scholar" class="right-sb-logo-img" />
              </a>
              <a href="https://www.researchgate.net" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card" title="ResearchGate Scientific Network">
                <img src="/images/indexes/researchgate.svg" alt="ResearchGate" class="right-sb-logo-img" />
              </a>
              <a href={osfRecord ? osfRecord.osfUrl : "https://osf.io/64xda/"} target="_blank" rel="noopener noreferrer" class="right-sb-logo-card" title="Open Science Framework (OSF)">
                <img src="/images/indexes/osf.png" alt="OSF" class="right-sb-logo-img" />
              </a>
              <a href="https://orcid.org/0009-0008-1310-6169" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card" title="ORCID Verified Researcher">
                <img src="/images/indexes/orcid.png" alt="ORCID" class="right-sb-logo-img" />
              </a>
              <a href="https://sinta.kemdikbud.go.id" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card" title="SINTA Kemendikbudristek">
                <img src="/images/indexes/sinta.png" alt="SINTA" class="right-sb-logo-img" />
              </a>
            </div>
          </div>

        </aside>

        <!-- ── MOBILE DOCK & SLIDE-UP DRAWERS (ACTIVE ONLY ON MOBILE <= 768px) ── -->
        <nav class="mobile-bottom-dock" aria-label="Navigasi Aksi Cepat Mobile">
          <button type="button" class="btn-dock-item" id="btn-open-mobile-toc" aria-label="Buka Daftar Isi">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            <span>Daftar Isi</span>
          </button>
          <button type="button" class="btn-dock-item" id="btn-open-mobile-meta" aria-label="Buka Metadata dan Indeks">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span>Metadata &amp; Indeks</span>
          </button>
          <a href={articlePdfPath} target="_blank" download={articleDownloadName} class="btn-dock-item dock-pdf-btn" title="Unduh Galley PDF">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Unduh PDF</span>
          </a>
        </nav>

        <!-- Drawer Backdrop Overlay -->
        <div class="mobile-sheet-backdrop" id="mobile-sheet-backdrop"></div>

        <!-- Drawer 1: TOC (Daftar Isi & Versi Naskah) -->
        <div class="mobile-slide-sheet" id="mobile-toc-sheet" role="dialog" aria-modal="true" aria-label="Daftar Isi &amp; Navigasi Naskah">
          <div class="sheet-header">
            <div class="sheet-title-group">
              <span class="sheet-kicker">NAVIGASI NASKAH</span>
              <h3 class="sheet-title">Daftar Isi &amp; Versi Naskah</h3>
            </div>
            <button type="button" class="btn-close-sheet" id="btn-close-toc-sheet" aria-label="Tutup Menu">&times;</button>
          </div>
          <div class="sheet-body">
            <div class="sheet-toc-nav">
              <a href="#abstrak" class="sheet-toc-item">
                <span class="sheet-num">01</span>
                <span>Abstrak &amp; Kata Kunci Riset</span>
                <span class="sheet-arrow">&rarr;</span>
              </a>
              <a href="#pembaca-pdf" class="sheet-toc-item">
                <span class="sheet-num">02</span>
                <span>Pembaca PDF Resmi</span>
                <span class="sheet-arrow">&rarr;</span>
              </a>
              <a href="#naskah-prose" class="sheet-toc-item">
                <span class="sheet-num">03</span>
                <span>Naskah Lengkap (IMRAD Structure)</span>
                <span class="sheet-arrow">&rarr;</span>
              </a>
              <a href="#pustaka" class="sheet-toc-item">
                <span class="sheet-num">04</span>
                <span>Daftar Pustaka Primer</span>
                <span class="sheet-arrow">&rarr;</span>
              </a>
              <a href="#sitasi-akademik" class="sheet-toc-item">
                <span class="sheet-num">05</span>
                <span>Sitasi &amp; Format Rujukan</span>
                <span class="sheet-arrow">&rarr;</span>
              </a>
            </div>

            {hasMultipleVersions && (
              <div class="sheet-versions-section">
                <span class="sheet-kicker">RIWAYAT VERSI RESMI (ZENODO)</span>
                <div class="sheet-versions-list">
                  {versionData.versions.map((ver: any) => (
                    <button
                      type="button"
                      class={`sheet-version-btn ${ver.isLatest ? 'active' : ''}`}
                      data-version-target={ver.versionNum}
                    >
                      <span class="sh-v-badge">{ver.version}</span>
                      <span class="sh-v-doi">doi:{ver.doi}</span>
                      <span class="sh-v-tag">{ver.isLatest ? 'LATEST' : 'ARCHIVED'}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Drawer 2: Metadata, Sitasi & Indeksasi -->
        <div class="mobile-slide-sheet" id="mobile-meta-sheet" role="dialog" aria-modal="true" aria-label="Metadata Publikasi &amp; Indeks">
          <div class="sheet-header">
            <div class="sheet-title-group">
              <span class="sheet-kicker">METADATA PUBLIKASI</span>
              <h3 class="sheet-title">Sitasi, Indeks &amp; Dokumen</h3>
            </div>
            <button type="button" class="btn-close-sheet" id="btn-close-meta-sheet" aria-label="Tutup Menu">&times;</button>
          </div>
          <div class="sheet-body">
            <!-- Action Sitasi Cepat -->
            <div class="sheet-section">
              <span class="sheet-kicker">SALIN SITASI CEPAT</span>
              <div class="sheet-citation-btns">
                <button type="button" class="sheet-btn-cite primary" id="btn-sheet-copy-apa">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="label-sheet-copy-apa">Salin Format APA</span>
                </button>
                <button type="button" class="sheet-btn-cite secondary" id="btn-sheet-copy-bibtex">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                  <span id="label-sheet-copy-bibtex">Salin Format BibTeX</span>
                </button>
              </div>
            </div>

            <!-- Metadata Singkat -->
            <div class="sheet-section">
              <span class="sheet-kicker">RINGKASAN METADATA</span>
              <div class="sheet-meta-rows">
                <div class="sh-meta-row">
                  <span class="sh-meta-lbl">CERN Zenodo DOI:</span>
                  <a href={`https://doi.org/${articleDoi}`} target="_blank" rel="noopener noreferrer" class="sh-meta-link">
                    {articleDoi} ↗
                  </a>
                </div>
                {osfRecord && (
                  <div class="sh-meta-row">
                    <span class="sh-meta-lbl">OSF Global DOI:</span>
                    <a href={`https://doi.org/${osfRecord.osfDoi}`} target="_blank" rel="noopener noreferrer" class="sh-meta-link">
                      {osfRecord.osfDoi} ↗
                    </a>
                  </div>
                )}
                <div class="sh-meta-row">
                  <span class="sh-meta-lbl">Tanggal Submisi (Created):</span>
                  <span>{historyDates.received}</span>
                </div>
                <div class="sh-meta-row">
                  <span class="sh-meta-lbl">Tanggal Terbit (Modified):</span>
                  <span class="font-bold">{historyDates.published}</span>
                </div>
                <div class="sh-meta-row">
                  <span class="sh-meta-lbl">Penulis &amp; ORCID:</span>
                  <span>{displayAuthors.join(', ')} (ORCID 0009-0008-1310-6169)</span>
                </div>
                <div class="sh-meta-row">
                  <span class="sh-meta-lbl">Lisensi:</span>
                  <span class="meta-license-pill">CC BY 4.0 Open Access</span>
                </div>
              </div>
            </div>

            <!-- Indexing Logos -->
            <div class="sheet-section">
              <span class="sheet-kicker">STANDAR INDEKS TERVERIFIKASI</span>
              <div class="sheet-indexing-grid">
                <a href="https://www.scopus.com" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/scopus.png" alt="Scopus" class="right-sb-logo-img scopus-img" />
                </a>
                <a href="https://zenodo.org" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/zenodo.png" alt="Zenodo" class="right-sb-logo-img" />
                </a>
                <a href="https://crossref.org" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/crossref.png" alt="Crossref" class="right-sb-logo-img" />
                </a>
                <a href="https://scholar.google.com" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/google-scholar.webp" alt="Google Scholar" class="right-sb-logo-img" />
                </a>
                <a href="https://www.researchgate.net" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/researchgate.svg" alt="ResearchGate" class="right-sb-logo-img" />
                </a>
                <a href={osfRecord ? osfRecord.osfUrl : "https://osf.io/64xda/"} target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/osf.png" alt="OSF" class="right-sb-logo-img" />
                </a>
                <a href="https://orcid.org/0009-0008-1310-6169" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/orcid.png" alt="ORCID" class="right-sb-logo-img" />
                </a>
                <a href="https://sinta.kemdikbud.go.id" target="_blank" rel="noopener noreferrer" class="right-sb-logo-card">
                  <img src="/images/indexes/sinta.png" alt="SINTA" class="right-sb-logo-img" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    ) : (
      <!-- ════════════════════════════════════════════════════════════════ -->
      <!-- 🏢 DEDICATED OFFICIAL CORPORATE NEWS / PRESS RELEASE WORKSPACE -->
      <!-- ════════════════════════════════════════════════════════════════ -->
      <article class="corporate-article-container" itemscope itemtype="https://schema.org/NewsArticle">
        <div class="container corporate-article-inner">
          
          <!-- Article Header -->
          <header class="corp-article-header">
            <div class="corp-meta-top-row">
              <span class="corp-tag-badge red-text">{article.tag}</span>
              <span class="corp-verified-badge">
                <svg viewBox="0 0 20 20" width="14" height="14" fill="#16a34a"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Siaran Pers Resmi Korporasi</span>
              </span>
            </div>

            <h1 class="corp-article-title" itemprop="headline">{cleanTitle}</h1>

            {cleanExcerpt && (
              <p class="corp-article-lead" itemprop="description">
                {cleanExcerpt}
              </p>
            )}

            <div class="corp-byline-bar">
              <div class="corp-author-info">
                <div class="corp-avatar-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <div class="corp-author-text">
                  <span class="corp-author-name">{article.author || 'Divisi Komunikasi Korporat'}</span>
                  <span class="corp-author-role">Sekretariat Perusahaan PT CHAIN ASIA CONECT</span>
                </div>
              </div>

              <div class="corp-meta-stats">
                <span class="corp-stat-item">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  <span>{article.date}</span>
                </span>
                <span class="corp-meta-sep">•</span>
                <span class="corp-stat-item">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  <span>{article.readTime || '3 min baca'}</span>
                </span>
              </div>
            </div>

            <!-- Share Buttons Row -->
            <div class="corp-share-actions-row">
              <span class="share-row-label">Bagikan Berita:</span>
              <div class="share-buttons-group">
                <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(cleanTitle + ' - ' + canonicalUrl)}`} target="_blank" rel="noopener noreferrer" class="btn-share-social btn-share-wa">
                  <span>WhatsApp</span>
                </a>
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" class="btn-share-social btn-share-in">
                  <span>LinkedIn</span>
                </a>
                <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(cleanTitle)}&url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener noreferrer" class="btn-share-social btn-share-x">
                  <span>X / Twitter</span>
                </a>
                <button type="button" class="btn-share-social btn-share-copy" id="btn-copy-corp-url" data-url={canonicalUrl}>
                  <span id="btn-copy-corp-text">Salin Tautan</span>
                </button>
              </div>
            </div>
          </header>

          <!-- Featured Visual / Media -->
          {dynamicArticleImage && (
            <figure class="corp-featured-media-box">
              <img 
                src={dynamicArticleImage} 
                alt={cleanTitle} 
                class="corp-featured-img" 
                loading="eager" 
                referrerpolicy="no-referrer"
              />
              <figcaption class="corp-media-caption">
                Dokumentasi resmi rilis pers PT CHAIN ASIA CONECT. Seluruh materi visual dilindungi hak cipta publikasi korporasi.
              </figcaption>
            </figure>
          )}

          <!-- Article Body -->
          <div class="corp-editorial-body" itemprop="articleBody">
            {parsedBlocks.map((block) => {
              if (block.type === 'html' || block.type === 'table') {
                return <div class="rich-html-block corp-rich-block" set:html={block.html} />;
              }
              if (block.type === 'heading') {
                return <h2 class="corp-heading-sub">{block.html}</h2>;
              }
              if (block.type === 'quote' || (block.html && (block.html.startsWith('&quot;') || block.html.startsWith('"') || block.html.startsWith('“')))) {
                return <blockquote class="corp-quote-block" set:html={block.html} />;
              }
              if (block.type === 'list') {
                return (
                  <ul class="corp-bullet-list">
                    {block.items.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                );
              }
              return <p class="corp-body-para" set:html={block.html} />;
            })}
          </div>

          <!-- Corporate Boilerplate & Media Contact Box -->
          <section class="corp-boilerplate-section" aria-label="Tentang PT CHAIN ASIA CONECT">
            <div class="corp-boilerplate-box">
              <h3 class="bp-title">Tentang PT CHAIN ASIA CONECT</h3>
              <p class="bp-text">
                PT CHAIN ASIA CONECT adalah perseroan berbadan hukum resmi Indonesia (SK Kemenkumham RI No. AHU-A117353.AH.01.30.Tahun 2026, NIB 0709260109599, KBLI 62193) yang beroperasi di sektor arsitektur teknologi blockchain rantai pasok komersial, lisensi perangkat lunak medis diagnostik PACS &amp; DICOM cloud, dan tata kelola transparansi rantai pasok kawasan 3T Krui Pesisir Barat.
              </p>
              
              <div class="bp-contact-card">
                <span class="bp-contact-title">Kontak Hubungan Media &amp; Hubungan Investor:</span>
                <div class="bp-contact-grid">
                  <div class="bp-contact-col">
                    <strong>Sekretariat Perusahaan:</strong><br />
                    Surel: <a href="mailto:corsec@chainasiaconnect.co.id">corsec@chainasiaconnect.co.id</a><br />
                    Surel Umum: <a href="mailto:info@chainasiaconnect.co.id">info@chainasiaconnect.co.id</a>
                  </div>
                  <div class="bp-contact-col">
                    <strong>Kantor &amp; Perwakilan:</strong><br />
                    Menara Kadin Indonesia Lt. 30, Jl. H.R. Rasuna Said, Jakarta Selatan<br />
                    Hotline: <a href="https://wa.me/6282181785743">+62 821-8178-5743</a>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Back to Newsroom CTA -->
          <div class="corp-back-bottom-cta">
            <a href="/newsroom" class="btn-corp-back">
              <span>&larr; Kembali ke Indeks Newsroom</span>
            </a>
          </div>

        </div>
      </article>
    )}

    <!-- Saran News Section (Full-Width Clean Newspaper List - No Sidebar, No Boxed Card) -->
    {suggestions.length > 0 && (
      <section class="suggestions-section" aria-label="Berita Rekomendasi">
        <div class="container suggestions-fullwidth-wrap">
          <div class="suggestions-header-bar">
            <h2 class="suggestions-heading">{isAcademicPaper ? 'Naskah Riset Terkait (JCFAD)' : 'Rilis Korporasi Terkait'}</h2>
            <span class="suggestions-sub">{isAcademicPaper ? 'Kajian ilmiah lainnya yang dipublikasikan pada Journal of Coastal Frontiers & Applied Development.' : 'Siaran pers resmi dan pembaruan agenda bisnis lainnya dari PT CHAIN ASIA CONECT.'}</span>
          </div>
          
          <div class="articles-clean-list">
            {suggestions.map((sug) => {
              const sugUrl = isAcademicPaper
                ? `https://journal.chainasiaconnect.co.id/${sug.slug}`
                : `/newsroom/${sug.slug}`;
              const hasCustomPhoto = Boolean(
                !isAcademicPaper &&
                sug.imageUrl &&
                !sug.imageUrl.includes('CAC-LOGO') &&
                !sug.imageUrl.includes('jcfad-seal') &&
                !sug.imageUrl.includes('unsplash') &&
                sug.imageUrl.trim() !== ''
              );
              return (
              <a href={sugUrl} class="article-row-link">
                <article class="article-row">
                  {hasCustomPhoto && (
                    <div class="article-thumb-box">
                      <img 
                        src={formatImageUrl(sug.imageUrl)} 
                        alt={sug.title} 
                        loading="lazy" 
                        referrerpolicy="no-referrer"
                        class="article-thumb-img"
                      />
                    </div>
                  )}
                  <div class="article-content-box">
                    <div class="article-meta-line">
                      <span class="meta-tag red-text">{sug.tag || (isAcademicPaper ? 'EMPIRICAL RESEARCH' : 'KORPORASI')}</span>
                      {sug.doi && <span class="meta-doi-sub">DOI: {sug.doi}</span>}
                      <span class="meta-date">{sug.date}</span>
                      <span class="meta-readtime">• {sug.readTime}</span>
                    </div>
                    <h3 class="article-title">{sug.title}</h3>
                    <p class="article-excerpt">{sug.excerpt || sug.content}</p>
                    <span class="article-arrow-cta red-text">{isAcademicPaper ? 'Baca Naskah di Jurnal →' : 'Baca Rilis Lengkap →'}</span>
                  </div>
                </article>
              </a>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>



<style>
  .reading-page-main {
    background: #ffffff;
    padding-top: 5.5rem;
  }

  /* Navigation Bar */
  .reading-nav-bar {
    background: #f8fafc;
