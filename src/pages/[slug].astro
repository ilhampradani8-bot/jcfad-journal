  function initOjsFeatures() {
    // Turnitin Exemption Copy
    const turnitinBtn = document.getElementById('btn-copy-turnitin-text');
    if (turnitinBtn) {
      turnitinBtn.addEventListener('click', () => {
        const statement = turnitinBtn.getAttribute('data-statement') || '';
        navigator.clipboard.writeText(statement).then(() => {
          const label = document.getElementById('turnitin-btn-label');
          if (label) {
            const original = label.textContent;
            label.textContent = '✓ Pernyataan Tersalin!';
            setTimeout(() => {
              label.textContent = original;
            }, 2500);
          }
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOjsFeatures);
  } else {
    initOjsFeatures();
  }
</script>

<script>
  function initCitationBox() {
    const box = document.querySelector('.paper-citation-box-clean');
    if (!box) return;

    const apaText = box.getAttribute('data-apa') || '';
    const bibtexText = box.getAttribute('data-bibtex') || '';

    const tabApa = document.getElementById('btn-tab-apa');
    const tabBibtex = document.getElementById('btn-tab-bibtex');
    const codeEl = document.getElementById('citation-display-code');
    const copyBtn = document.getElementById('btn-copy-active-cite');

    if (tabApa && tabBibtex && codeEl && copyBtn) {
      tabApa.addEventListener('click', () => {
        tabApa.classList.add('active');
        tabBibtex.classList.remove('active');
        codeEl.textContent = apaText;
        copyBtn.setAttribute('data-cite', apaText);
      });

      tabBibtex.addEventListener('click', () => {
        tabBibtex.classList.add('active');
        tabApa.classList.remove('active');
        codeEl.textContent = bibtexText;
        copyBtn.setAttribute('data-cite', bibtexText);
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = copyBtn.getAttribute('data-cite') || apaText;
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
          const label = copyBtn.querySelector('.btn-copy-label');
          if (label) {
            const original = label.textContent;
            label.textContent = '✓ Tersalin ke Clipboard!';
            setTimeout(() => {
              label.textContent = original;
            }, 2000);
          }
        });
      });
    }

    const handleCopyApa = (btn: HTMLElement, labelId: string) => {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(apaText).then(() => {
          const label = document.getElementById(labelId);
          if (label) {
            const original = label.textContent;
            label.textContent = '✓ Sitasi Tersalin!';
            setTimeout(() => {
              label.textContent = original;
            }, 2000);
          }
        });
      });
    };

    const sideCopyBtn = document.getElementById('btn-copy-apa-citation');
    if (sideCopyBtn) handleCopyApa(sideCopyBtn, 'btn-copy-citation-text');

    const freezeCopyBtn = document.getElementById('sidebar-btn-copy-apa-citation');
    if (freezeCopyBtn) handleCopyApa(freezeCopyBtn, 'sidebar-btn-copy-citation-text');

    const rightCopyApaBtn = document.getElementById('btn-right-copy-apa');
    if (rightCopyApaBtn) handleCopyApa(rightCopyApaBtn, 'label-right-copy-apa');

    const sheetCopyApaBtn = document.getElementById('btn-sheet-copy-apa');
    if (sheetCopyApaBtn) handleCopyApa(sheetCopyApaBtn, 'label-sheet-copy-apa');

    const rightCopyBibBtn = document.getElementById('btn-right-copy-bibtex');
    if (rightCopyBibBtn) {
      rightCopyBibBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(bibtexText).then(() => {
          const label = document.getElementById('label-right-copy-bibtex');
          if (label) {
            const original = label.textContent;
            label.textContent = '✓ BibTeX Tersalin!';
            setTimeout(() => {
              label.textContent = original;
            }, 2000);
          }
        });
      });
    }

    const sheetCopyBibBtn = document.getElementById('btn-sheet-copy-bibtex');
    if (sheetCopyBibBtn) {
      sheetCopyBibBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(bibtexText).then(() => {
          const label = document.getElementById('label-sheet-copy-bibtex');
          if (label) {
            const original = label.textContent;
            label.textContent = '✓ BibTeX Tersalin!';
            setTimeout(() => {
              label.textContent = original;
            }, 2000);
          }
        });
      });
    }

    // Mobile Bottom Dock & Slide-Up Drawers Controller
    const btnOpenToc = document.getElementById('btn-open-mobile-toc');
    const btnOpenMeta = document.getElementById('btn-open-mobile-meta');
    const tocSheet = document.getElementById('mobile-toc-sheet');
    const metaSheet = document.getElementById('mobile-meta-sheet');
    const backdrop = document.getElementById('mobile-sheet-backdrop');
    const btnCloseToc = document.getElementById('btn-close-toc-sheet');
    const btnCloseMeta = document.getElementById('btn-close-meta-sheet');

    function closeAllSheets() {
      if (tocSheet) tocSheet.classList.remove('open');
      if (metaSheet) metaSheet.classList.remove('open');
      if (backdrop) backdrop.classList.remove('open');
      document.body.style.overflow = '';
    }

    if (btnOpenToc && tocSheet && backdrop) {
      btnOpenToc.addEventListener('click', () => {
        if (metaSheet) metaSheet.classList.remove('open');
        tocSheet.classList.add('open');
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    }

    if (btnOpenMeta && metaSheet && backdrop) {
      btnOpenMeta.addEventListener('click', () => {
        if (tocSheet) tocSheet.classList.remove('open');
        metaSheet.classList.add('open');
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    }

    if (btnCloseToc) btnCloseToc.addEventListener('click', closeAllSheets);
    if (btnCloseMeta) btnCloseMeta.addEventListener('click', closeAllSheets);
    if (backdrop) backdrop.addEventListener('click', closeAllSheets);

    document.querySelectorAll('.sheet-toc-item').forEach(item => {
      item.addEventListener('click', () => {
        closeAllSheets();
      });
    });

    // Toggle Sembunyikan / Tampilkan Naskah Teks (HTML Transkrip)
    const toggleProseBtn = document.getElementById('btn-toggle-prose');
    const proseBody = document.getElementById('naskah-prose-body');
    const toggleLabel = document.getElementById('label-toggle-prose');
    if (toggleProseBtn && proseBody && toggleLabel) {
      toggleProseBtn.addEventListener('click', () => {
        const isHidden = proseBody.style.display === 'none';
        proseBody.style.display = isHidden ? 'block' : 'none';
        toggleLabel.textContent = isHidden ? 'Sembunyikan Naskah Teks ▲' : 'Tampilkan Naskah Teks ▼';
        toggleProseBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCitationBox);
  } else {
    initCitationBox();
  }
</script>

