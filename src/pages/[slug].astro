  /* Byline Status Clean (Tanpa Card) */
  .byline-status-clean {
    color: #111111;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  /* Actions & Index Strip Full-Width */
  .article-actions-strip-full {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding: 0.85rem 0 1.25rem 0;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .action-buttons-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .index-indicators-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-size: 0.72rem;
    color: #475569;
  }

  .index-heading-label {
    font-weight: 800;
    color: #111111;
    letter-spacing: 0.05em;
    margin-right: 0.2rem;
  }

  .index-item-text {
    font-weight: 600;
    color: #334155;
  }

  .index-dot {
    color: #cbd5e1;
    font-size: 0.65rem;
  }

  .btn-classic-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background: #111111;
    color: #ffffff;
    border: 1.5px solid #111111;
