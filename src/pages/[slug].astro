    color: #334155;
    margin: 0;
  }

  .journal-version-banner.is-archive-mode .banner-pill-active {
    color: #b91c1c;
  }

  .journal-version-banner.is-archive-mode .banner-date-label {
    color: #b91c1c;
  }

  .journal-version-banner.is-archive-mode .version-banner-text {
    color: #1e293b;
  }

  .banner-concept-doi code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    color: #0f172a;
    text-decoration: underline;
  }

  .banner-quick-switch {
    margin-top: 0.65rem;
  }

  .btn-banner-switch-latest {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #111111;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.35rem 0.85rem;
    border: 1px solid #111111;
    border-radius: 0;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-banner-switch-latest:hover {
    background: #dc2626;
    border-color: #dc2626;
  }

  /* V1 Archive Watermark (Batas Garis Saja, Tanpa Card Kuning, Tanpa Garis Kiri) */
  .v1-archive-watermark {
    background: transparent;
    border-top: 1px solid #111111;
    border-bottom: 1px solid #111111;
    border-left: none !important;
    border-right: none !important;
    padding: 0.65rem 0;
    margin-bottom: 1.5rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #111111;
  }

  .article-subheading-h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    margin: 1.5rem 0 0.5rem;
  }

  .version-banner-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }

  .banner-pill-active {
    font-size: 0.66rem;
    font-weight: 800;
