    text-decoration: underline;
  }

  .current-crumb {
    color: var(--red-primary, #dc2626);
    font-weight: 700;
  }

  /* Article Layout */
  .article-container {
    padding: 3.5rem 0 4.5rem 0;
  }

  .article-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Sharp & Compact Article Layout (Tanpa Card Berlapis) */
  .article-header-sharp {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .author-correspondence-sub {
