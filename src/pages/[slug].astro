<script>
  function initDynamicVersionSwitcher() {
    const metaEl = document.getElementById('version-meta-data');
    if (!metaEl) return;

    let config;
    try {
      config = JSON.parse(metaEl.textContent || '{}');
    } catch (_) {
      return;
    }

    if (!config || !config.hasMultipleVersions) {
      return;
    }

    const layerV2 = document.getElementById('layer-version-2');
    const layerV1 = document.getElementById('layer-version-1');
    const bannerBox = document.getElementById('journal-version-banner-box');
    const bannerPill = document.getElementById('banner-pill-label');
    const bannerDate = document.getElementById('banner-date-label');
    const bannerDesc = document.getElementById('banner-desc-text');
    const bannerSwitchWrap = document.getElementById('banner-switch-wrap');
    const quickSwitchBtn = document.getElementById('btn-banner-switch-latest');
    const headline = document.querySelector('.article-headline-sharp');
    const abstractEl = document.querySelector('#abstrak .abstract-text');
    const citationCode = document.getElementById('citation-display-code');

    function switchVersion(verNum) {
      const target = config.versionsMap ? config.versionsMap[String(verNum)] : null;
      if (!target) return;
      const isV1 = String(verNum) === '1';

      // 1. Toggle Article Body Layers
      if (layerV2 && layerV1) {
        layerV2.style.display = isV1 ? 'none' : 'block';
        layerV1.style.display = isV1 ? 'block' : 'none';
      }

      // 2. Toggle active state on Sidebar version buttons & Sheet buttons
      document.querySelectorAll('.sidebar-version-item-btn').forEach(btn => {
        const btnVer = btn.getAttribute('data-version-target');
        const hint = btn.querySelector('.sb-indicator-text');
        if (btnVer === String(verNum)) {
          btn.classList.add('active');
          if (hint) hint.textContent = '● Naskah Aktif Ditampilkan';
        } else {
          btn.classList.remove('active');
          if (hint) hint.textContent = '↗ Muat Naskah Versi Ini';
        }
      });

      document.querySelectorAll('.sheet-version-btn').forEach(btn => {
        const btnVer = btn.getAttribute('data-version-target');
        if (btnVer === String(verNum)) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      // 3. Toggle active state on PDF Reader Multi-Tabs
      document.querySelectorAll('.btn-pdf-tab-toggle').forEach(tab => {
        const tabVer = tab.getAttribute('data-pdf-ver');
        if (tabVer === String(verNum)) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      // 4. Update Headline & Abstract
      if (headline && target.title) {
        headline.textContent = target.title;
      }
      if (abstractEl && target.abstract) {
        abstractEl.textContent = target.abstract;
      }

      // 5. Update Banner Notice
      if (bannerBox) {
        if (target.isLatest) {
          bannerBox.classList.remove('is-archive-mode');
          if (bannerPill) bannerPill.textContent = 'PUBLIKASI RESMI TERBARU • ' + (target.versionLabel || ('VERSION ' + verNum)).toUpperCase();
          if (bannerDate) bannerDate.textContent = 'Terbit: ' + target.date;
          if (bannerDesc) {
            bannerDesc.innerHTML = 'Anda sedang membaca <strong>' + (target.versionLabel || ('Version ' + verNum)) + ' (Latest Peer-Reviewed Article)</strong> yang diterbitkan dalam standar bahasa Inggris akademis (Full Academic English) pada <em>Journal of Coastal Frontiers &amp; Applied Development (JCFAD)</em> Vol. 1 No. 1. Naskah kerja awal (Version 1 Preprint) tetap terarsip secara permanen di repositori CERN Zenodo via Concept DOI <a href="https://doi.org/' + config.conceptDoi + '" target="_blank" rel="noopener noreferrer" class="banner-concept-doi"><code>' + config.conceptDoi + '</code></a>.';
          }
          if (bannerSwitchWrap) bannerSwitchWrap.style.display = 'none';
        } else if (isV1) {
          bannerBox.classList.add('is-archive-mode');
          if (bannerPill) bannerPill.textContent = '⚠️ ARSIP WORKING PAPER / PREPRINT • VERSION 1';
          if (bannerDate) bannerDate.textContent = 'Arsip: ' + target.date;
          if (bannerDesc) {
            bannerDesc.innerHTML = 'Perhatian: Anda sedang membaca <strong>Version 1 (Initial Preprint Archive)</strong> naskah bahasa Indonesia. Versi terbitan peer-reviewed resmi terbaru dalam Full Academic English tersedia pada <strong>Version ' + (config.currentVersion || '4') + '</strong>.';
          }
          if (bannerSwitchWrap) bannerSwitchWrap.style.display = 'block';
        } else {
          bannerBox.classList.add('is-archive-mode');
          if (bannerPill) bannerPill.textContent = '⚠️ ARSIP SEBELUMNYA • ' + (target.versionLabel || ('VERSION ' + verNum)).toUpperCase();
          if (bannerDate) bannerDate.textContent = 'Arsip: ' + target.date;
          if (bannerDesc) {
            bannerDesc.innerHTML = 'Perhatian: Anda sedang membaca <strong>' + (target.versionLabel || ('Version ' + verNum)) + '</strong>. Versi terbitan peer-reviewed resmi terbaru (Definitive Edition) tersedia pada <strong>Version ' + (config.currentVersion || '4') + '</strong>.';
          }
          if (bannerSwitchWrap) bannerSwitchWrap.style.display = 'block';
        }
      }

      // 6. Update Embedded PDF Master Iframe in Realtime (Zero Load Error)
      const iframe = document.getElementById('main-embedded-pdf-iframe') || document.querySelector('.embedded-pdf-frame');
      if (iframe && target.pdfUrl) {
        iframe.src = target.pdfUrl + '#toolbar=1&navpanes=0&pagemode=none&view=FitH';
      }

      // 7. Update PDF Viewer Controls (Fullscreen & Direct Download)
      const fsBtn = document.getElementById('btn-pdf-viewer-fullscreen');
      if (fsBtn && target.pdfUrl) fsBtn.setAttribute('href', target.pdfUrl);
      const dlBtn = document.getElementById('btn-pdf-viewer-download');
      if (dlBtn && target.pdfUrl) dlBtn.setAttribute('href', target.pdfUrl);

      document.querySelectorAll('a[download], .btn-classic-primary, .btn-download-sharp, .btn-floating-pdf').forEach(a => {
        a.setAttribute('href', target.pdfUrl);
      });

      // 8. Update DOI Pill
      document.querySelectorAll('.meta-doi-pill').forEach(a => {
        a.setAttribute('href', 'https://doi.org/' + target.doi);
        a.textContent = 'DOI: ' + target.doi + ' ↗';
      });

      // 9. Update Citation text
      if (citationCode && target.citation) {
        citationCode.textContent = target.citation;
        const copyBtn = document.getElementById('btn-copy-active-cite');
        if (copyBtn) copyBtn.setAttribute('data-cite', target.citation);
      }

      // 10. Update URL param ?v=X without reload
      try {
        const u = new URL(window.location.href);
        u.searchParams.set('v', String(verNum));
        window.history.replaceState({}, '', u.toString());
      } catch (_) {}
    }

    // Bind event listeners to Sidebar & Mobile Sheet version buttons
    document.querySelectorAll('.sidebar-version-item-btn, .sheet-version-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const v = btn.getAttribute('data-version-target');
        switchVersion(v);
        const tocSheet = document.getElementById('mobile-toc-sheet');
        const backdrop = document.getElementById('mobile-sheet-backdrop');
        if (tocSheet) tocSheet.classList.remove('open');
        if (backdrop) backdrop.classList.remove('open');
        document.body.style.overflow = '';
      });
    });

    // Bind event listeners to PDF Viewer Multi-Tabs
    document.querySelectorAll('.btn-pdf-tab-toggle').forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const v = tab.getAttribute('data-pdf-ver');
        switchVersion(v);
      });
    });

    if (quickSwitchBtn) {
      quickSwitchBtn.addEventListener('click', (e) => {
        e.preventDefault();
        switchVersion(config.currentVersion || '4');
      });
    }

    // Check URL parameter ?v=1 or ?v=2 on load
    try {
      const p = new URLSearchParams(window.location.search);
      const vParam = p.get('v');
      if (vParam) {
        switchVersion(vParam);
      }
    } catch (_) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDynamicVersionSwitcher);
  } else {
    initDynamicVersionSwitcher();
  }
</script>

<!-- Corporate Newsroom Interactive Scripts & Domain Enforcer -->
<script is:inline define:vars={{ isAcademicPaper, articleSlug: article.slug }}>
  // Enforce Clean Domain Separation on Browser Level:
  // Paper Ilmiah -> WAJIB di journal.chainasiaconnect.co.id
  // Berita Korporasi -> WAJIB di www.chainasiaconnect.co.id
  (function enforceDomainSeparation() {
    const host = window.location.hostname.toLowerCase();
    const isLocal = host === 'localhost' || host === '127.0.0.1';
    if (isLocal) return;

    if (isAcademicPaper) {
      if (host !== 'journal.chainasiaconnect.co.id') {
        window.location.replace('https://journal.chainasiaconnect.co.id/' + articleSlug);
      }
    } else {
      if (host === 'journal.chainasiaconnect.co.id') {
        window.location.replace('https://www.chainasiaconnect.co.id/newsroom/' + articleSlug);
      }
    }
  })();

  // Salin Tautan Berita Korporasi ke Clipboard
  document.addEventListener('DOMContentLoaded', function() {
    const copyBtn = document.getElementById('btn-copy-corp-url');
    if (copyBtn) {
      copyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        navigator.clipboard.writeText(url).then(function() {
          const textEl = document.getElementById('btn-copy-corp-text');
          if (textEl) {
            const original = textEl.textContent;
            textEl.textContent = '✓ Tautan Tersalin!';
            copyBtn.style.background = '#dcfce7';
            copyBtn.style.color = '#166534';
            copyBtn.style.borderColor = '#86efac';
            setTimeout(function() {
              textEl.textContent = original;
              copyBtn.style.background = '';
              copyBtn.style.color = '';
              copyBtn.style.borderColor = '';
            }, 2500);
          }
        });
      });
    }
  });
</script>
