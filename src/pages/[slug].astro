  .history-license {
    color: #111111;
    font-weight: 700;
  }

  .history-doi {
    color: #111111;
  }

  .meta-doi-inline {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: #0f172a;
    text-decoration: underline;
    font-size: 0.75rem;
  }

  .meta-doi-inline:hover {
    color: #dc2626;
  }

  /* Full-Width Classic Scholarly Layout (Tanpa Grid Sempit, Batas Garis Saja, Tanpa Card) */
  .academic-hero-fullwidth {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 0.5rem;
  }

  /* Journal Masthead Full-Width (Dual Hairline Rules) */
  .journal-classic-masthead-full {
    border-top: 2.5px solid #111111;
    border-bottom: 1.5px solid #111111;
    padding: 0.85rem 0;
    margin-bottom: 1.5rem;
    background: transparent;
  }

  .journal-masthead-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
  }

  .classic-masthead-seal {
