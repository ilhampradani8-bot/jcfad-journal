    transition: all 0.15s ease;
  }

  .btn-classic-primary:hover {
    background: #dc2626;
    border-color: #dc2626;
    color: #ffffff;
  }

  .btn-classic-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background: #ffffff;
    color: #111111;
    border: 1.5px solid #111111;
    border-radius: 0 !important;
    padding: 0.45rem 0.95rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-classic-secondary:hover {
    background: #111111;
    color: #ffffff;
  }

  /* Full-Width Classic Versions Switcher (Batas Garis Saja, Tanpa Card, Tanpa Garis Kiri) */
  .classic-versions-bar-full {
    border-top: 1.5px solid #111111;
    border-bottom: 1.5px solid #111111;
    padding: 0.95rem 0 1.15rem 0;
    margin: 1.25rem 0 1.5rem 0;
    background: transparent;
  }

  .versions-bar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #e2e8f0;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .versions-header-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #111111;
    text-transform: uppercase;
  }

  .concept-doi-inline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    color: #64748b;
  }

  .concept-doi-inline code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    color: #0f172a;
    font-weight: 700;
    text-decoration: underline;
  }

  .versions-horizontal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 0.85rem;
  }

  /* Tombol Versi Tanpa Card, Tanpa Garis Kiri */
  .version-item-btn {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.75rem 0.95rem;
    border: 1px solid #cbd5e1;
    border-left: 1px solid #cbd5e1;
