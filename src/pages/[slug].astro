  }

  .version-item-btn.active .version-click-hint {
    color: #111111;
    font-weight: 800;
  }

  .version-item-btn.is-archived.active .version-click-hint {
    color: #111111;
    font-weight: 800;
  }

  /* Version Notice Bar (Gausah Card, Gausah Garis Kiri, Batas Garis Tipis Saja) */
  .journal-version-banner {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0 0.95rem 0;
    margin-bottom: 1.5rem;
    background: transparent;
    border: none;
    border-bottom: 1px dashed #cbd5e1;
