    width: 100%;
  }

  .version-banner-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .banner-pill-active {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
